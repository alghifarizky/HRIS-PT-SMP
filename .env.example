# Salin ke .env.local lalu isi dari Supabase Dashboard → Project Settings → API.
# Hanya URL & anon key. JANGAN taruh service_role key di sini.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Alamat resmi aplikasi untuk link di email (undangan & lupa password), mis. https://hris-pt-smp.vercel.app
VITE_APP_URL=
